FORM stage .
  FREE: gt_stage,gv_stage.
  SELECT DISTINCT                                       "#EC CI_NOFIELD
             stage
      FROM zcrm_order
      INTO TABLE @DATA(lt_lstage)
      WHERE stage IN ('L1','L2','L3').

  SORT lt_lstage BY stage.
  LOOP AT lt_lstage INTO DATA(ls_lstage).
    IF ls_lstage-stage = 'L1'.
      gs_stage-key = ls_lstage-stage.
      gs_stage-text = 'L1'.
    ELSE.
      IF ls_lstage-stage = 'L2'.
        gs_stage-key = ls_lstage-stage.
        gs_stage-text = 'L2'.
      ELSE.
        IF ls_lstage-stage = 'L3'.
          gs_stage-key = ls_lstage-stage.
          gs_stage-text = 'L3'.
        ENDIF.
      ENDIF.
    ENDIF.


    APPEND gs_stage TO gt_stage.
    CLEAR: gs_stage,ls_lstage.
  ENDLOOP.

  gv_stage = 'P_STAGE'.
  CALL FUNCTION 'VRM_SET_VALUES'
    EXPORTING
      id     = gv_stage
      values = gt_stage
    EXCEPTIONS
*     ID_ILLEGAGV_NAME = 1
      OTHERS = 2.
  IF sy-subrc <> 0.
* Implement suitable error handling here
  ENDIF.
ENDFORM.
