FORM fetch_data_from_table .
  DATA : lv_date_low1(15)  TYPE c,
         lv_date2(15)      TYPE c,
         lv_date_high1(15) TYPE c.
  DATA  :lv_date_low2(15)  TYPE c,
         lv_date_high2(15) TYPE c.
  DATA : lt_hse_usr TYPE zcrmt_ppm_orgunitid_ta,
         lv_hse_pos TYPE objektid,
         username   TYPE uname.
  TYPES : BEGIN OF ty_object,
            object_id TYPE crmd_orderadm_h-object_id,
          END OF ty_object.
  DATA : it_object TYPE TABLE OF ty_object,
         ls_object LIKE LINE OF  it_object.
* End of change of DM1K964930 }

  IF gt_org IS NOT INITIAL OR call_flag = 'API_CALL'.
    IF p_zone IS NOT INITIAL.
      REPLACE ALL OCCURRENCES OF '*' IN p_zone WITH '%' IN CHARACTER MODE.                          "For Search all matching Records.
      CONCATENATE 'ZO' ' = ' '''' p_zone ''''
      INTO DATA(lv_where) RESPECTING BLANKS.
    ENDIF.

    IF p_reg IS NOT INITIAL.
      REPLACE ALL OCCURRENCES OF '*' IN p_reg WITH '%' IN CHARACTER MODE.                       "For Search all matching Records.
      IF lv_where IS INITIAL.
        CONCATENATE   'RO' ' = ' '''' p_reg ''''
              INTO lv_where RESPECTING BLANKS.
      ELSE.
        CONCATENATE  lv_where ' AND ' 'RO' ' = '
              '''' p_reg '''' INTO lv_where RESPECTING BLANKS.
      ENDIF.
    ENDIF.

    IF p_area IS NOT INITIAL.
      REPLACE ALL OCCURRENCES OF '*' IN p_area WITH '%' IN CHARACTER MODE.                       "For Search all matching Records.
      IF lv_where IS INITIAL.
        CONCATENATE   'AO' ' = ' '''' p_area ''''
              INTO lv_where RESPECTING BLANKS.
      ELSE.
        CONCATENATE  lv_where ' AND ' 'AO' ' = '
              '''' p_area '''' INTO lv_where RESPECTING BLANKS.
      ENDIF.
    ENDIF.

    IF p_so IS NOT INITIAL.
      REPLACE ALL OCCURRENCES OF '*' IN p_so WITH '%' IN CHARACTER MODE.                       "For Search all matching Records.
      IF lv_where IS INITIAL.
        CONCATENATE   'SO' ' = ' '''' p_so ''''
              INTO lv_where RESPECTING BLANKS.
      ELSE.
        CONCATENATE  lv_where ' AND ' 'SO' ' = '
              '''' p_so '''' INTO lv_where RESPECTING BLANKS.
      ENDIF.
    ENDIF.

    IF p_zdo IS NOT INITIAL.
      REPLACE ALL OCCURRENCES OF '*' IN p_zdo WITH '%' IN CHARACTER MODE.                       "For Search all matching Records.
      IF lv_where IS INITIAL.
        CONCATENATE   'ZDO' ' = ' '''' p_zdo ''''
              INTO lv_where RESPECTING BLANKS.
      ELSE.
        CONCATENATE  lv_where ' AND ' 'ZDO' ' = '
              '''' p_zdo '''' INTO lv_where RESPECTING BLANKS.
      ENDIF.
    ENDIF.

    IF p_mngr IS NOT INITIAL.
      REPLACE ALL OCCURRENCES OF '*' IN p_mngr WITH '%' IN CHARACTER MODE.                       "For Search all matching Records.
      IF lv_where IS INITIAL.
        CONCATENATE   'ZDO_M_BP' ' = ' '''' p_mngr ''''
              INTO lv_where RESPECTING BLANKS.
      ELSE.
        CONCATENATE  lv_where ' AND ' 'ZDO_M_BP' ' = '
              '''' p_mngr '''' INTO lv_where RESPECTING BLANKS.
      ENDIF.
    ENDIF.

    IF p_exec IS NOT INITIAL.
      REPLACE ALL OCCURRENCES OF '*' IN p_exec WITH '%' IN CHARACTER MODE.                       "For Search all matching Records.
      IF lv_where IS INITIAL.
        CONCATENATE   'DIV_SE_BP' ' = ' '''' p_exec ''''
              INTO lv_where RESPECTING BLANKS.
      ELSE.
        CONCATENATE  lv_where ' AND ' 'DIV_SE_BP' ' = '
              '''' p_exec '''' INTO lv_where RESPECTING BLANKS.
      ENDIF.
    ENDIF.

    DATA:gv_dstart TYPE sy-datum,
         gv_dend   TYPE sy-datum.
    IF s_cdate-low IS NOT INITIAL.
      gv_dstart = s_cdate-low.
    ELSE.
      gv_dstart = '20160101'.
    ENDIF.
    IF s_cdate-high IS INITIAL.
      gv_dend = sy-datum.
    ELSE.
      gv_dend = s_cdate-high.
    ENDIF.

    FREE : gt_org_d,
           gt_org.
*    CALL FUNCTION 'ZCRMRO_ORG_STRUCTURE_GET_SW'
    CALL FUNCTION 'ZCRMRO_ORG_STRUCTURE_GET_REP'
      EXPORTING
        i_userid = sy-uname
*       i_bdate  = '20160101'
*       i_edate  = sy-datum
      IMPORTING
        e_org    = gt_org_d.

    gt_org = gt_org_d.
    SORT gt_org BY zdo zdo_m_bp div_se_bp.
    DELETE ADJACENT DUPLICATES FROM gt_org COMPARING zdo zdo_m_bp div_se_bp.
    LOOP AT gt_org INTO gs_org WHERE (lv_where).

      s_sofc-low = gs_org-zdo.
      s_sofc-option =  'EQ'.
      s_sofc-sign =  'I'.
      APPEND s_sofc TO s_sofc.
      gs_org_x-zo_name = gs_org-zo_name.           " zone
      gs_org_x-ro_name = gs_org-ro_name.         " region
      gs_org_x-ao_name = gs_org-ao_name.           " area office
      gs_org_x-so_name = gs_org-so_name.             " dealership
      gs_org_x-zdo_name = gs_org-zdo_name.           " dealer outlet
      gs_org_x-zdo      = gs_org-zdo.              " dealer outlet code
      gs_org_x-zdo_m_name = gs_org-zdo_m_name.        " manager
      gs_org_x-div_se_bp = gs_org-div_se_bp.         " exec id
      gs_org_x-div_se_bp1 = gs_org-div_se_bp.         " exec id
      gs_org_x-div_se_name = gs_org-div_se_name.       " executive
      gs_org_x-zoutlet     = gs_org-zdo.                "Outlet
      gs_org_x-zdo_objid   = gs_org-zdo_objid.
      CONCATENATE 'O' gs_org_x-zdo_objid INTO           "Added by DM1K976745
        gs_org_x-zdo_objid1 SEPARATED BY space.
      APPEND gs_org_x TO gt_org_x.
      CLEAR :gs_org_x,gs_org.
    ENDLOOP.

    SORT : s_sofc BY low.
    DELETE ADJACENT DUPLICATES FROM s_sofc COMPARING low.

    SELECT user_id,ao,zposition,vertical,zdo FROM zcrmt_alse_map INTO TABLE @DATA(lt_map) WHERE user_id = @sy-uname AND de_act NE 'X'.
    IF sy-subrc EQ 0.
      DATA(user_alse) = 'X'.
      IF line_exists( lt_map[ zposition = 'AM' ] ).
      ELSEIF line_exists( lt_map[ zposition = 'ASM' ] ).
      ELSEIF line_exists( lt_map[ zposition = 'ALSE' ] ).
        DATA: rt_alse_zdo TYPE RANGE OF zoutlet.
        CLEAR rt_alse_zdo.
        rt_alse_zdo = VALUE #( FOR alse_zdo IN lt_map ( sign = 'I' option = 'EQ' low = alse_zdo-zdo ) ).
        DELETE gt_org_x WHERE zoutlet NOT IN rt_alse_zdo.
      ENDIF.
    ENDIF.

    IF s_udate IS NOT INITIAL.

      CLEAR : lv_date_low1, lv_date_high1.

      CONVERT DATE s_udate-low TIME sy-timlo INTO TIME STAMP DATA(lv_date_low) TIME ZONE sy-zonlo.

      CONVERT DATE s_udate-high TIME sy-timlo INTO TIME STAMP DATA(lv_date_high) TIME ZONE sy-zonlo.

      lv_date_low1 = lv_date_low.
      lv_date_high1 = lv_date_high.

    ENDIF.

    IF gt_verti IS NOT INITIAL.
      DATA(rt_verti) = VALUE tt_verti( FOR lv_verti IN gt_verti ( sign = 'I' option = 'EQ'
                                                                  low  = lv_verti-key ) ).
      SELECT DISTINCT                                   "#EC CI_NOWHERE
        a~segid ,
        a~segnm AS seg,
        c~vtext AS div,
        c~spart AS division
        FROM zcrmt_psegm_mstr AS a
        INNER JOIN zcrmt_sg_pap_sap AS b ON b~psegid = a~segid
        INNER JOIN tspat AS c ON c~spart = b~division
        INTO TABLE @DATA(lt_seg)
        WHERE c~spart IN @rt_verti AND c~spras = @sy-langu.
      IF p_verti IS NOT INITIAL.
        DELETE lt_seg WHERE division <> p_verti.
        SORT lt_seg STABLE BY segid.
        DELETE ADJACENT DUPLICATES FROM lt_seg COMPARING segid.
      ENDIF.
      DATA: ls_seg LIKE LINE OF lt_seg.
      IF user_alse NE 'X'.
        IF p_verti IS INITIAL.
          ls_seg-segid = 'PS009'.
          ls_seg-seg   = '4X2 SF HAULAGE'.
          ls_seg-div   = 'Long Haulage'.
          ls_seg-division = '40'.
          APPEND ls_seg TO lt_seg.
          CLEAR ls_seg.
          ls_seg-segid = 'PS010'.
          ls_seg-seg   = '4X2 SF TIPPER'.
          ls_seg-div   = 'C&M'.
          ls_seg-division = '50'.
          APPEND ls_seg TO lt_seg.
          CLEAR ls_seg.
        ENDIF.
      ENDIF.
    ENDIF.

    IF s_cdate IS NOT INITIAL AND s_udate IS NOT INITIAL.


      IF s_cdate-high IS INITIAL.
        lv_date_low2 =  s_cdate-low.
        lv_date_high2 = s_cdate-high.
      ENDIF.
      IF s_cdate-low IS NOT INITIAL AND s_cdate-high IS NOT INITIAL .
        lv_date_low2 =  s_cdate-low.
        lv_date_high2 = s_cdate-high.
      ENDIF.
      CONCATENATE 'B~CRE_DATE' ' BETWEEN ' '''' lv_date_low2 '''' ' AND ' '''' lv_date_high2 '''' ' AND '
*     CONCATENATE 'B~POSTING_DATE' ' BETWEEN ' '''' s_cdate-low '''' ' AND ' '''' s_cdate-high '''' ' AND '
*                  'B~CHANGED_AT' ' BETWEEN ' '''' lv_date_low1 '''' ' AND ' '''' lv_date_high1 ''''
                    'B~CH_DATE' ' BETWEEN ' '''' lv_date_low1 '''' ' AND ' '''' lv_date_high1 ''''
      INTO DATA(lv_where1) RESPECTING BLANKS.

    ELSEIF s_cdate IS NOT INITIAL AND s_udate IS INITIAL.

      IF  s_cdate-low IS NOT INITIAL AND  s_cdate-high IS NOT INITIAL.

        lv_date_low2 =  s_cdate-low.
        lv_date_high2 = s_cdate-high.

*        CONCATENATE  'B~POSTING_DATE' ' BETWEEN ' '''' s_cdate-low '''' ' AND ' '''' s_cdate-high ''''
        CONCATENATE  'B~CRE_DATE' ' BETWEEN ' '''' lv_date_low2 '''' ' AND ' '''' lv_date_high2 ''''
       INTO   lv_where1 RESPECTING BLANKS.
      ELSE.
        IF s_cdate-high IS INITIAL.
*          CONCATENATE s_cdate-low '000001' INTO lv_date_low2.
*          CONCATENATE s_cdate-low '235959' INTO lv_date_high2.
          lv_date_low2 =  s_cdate-low.
          lv_date_high2 = s_cdate-high.
        ENDIF.
*        CONCATENATE  'B~POSTING_DATE' ' EQ' '''' s_cdate-low ''''
        CONCATENATE  'B~CRE_DATE' ' BETWEEN ' '''' lv_date_low2 '''' ' AND ' '''' lv_date_high2 ''''
           INTO   lv_where1 RESPECTING BLANKS.
      ENDIF.

    ELSEIF s_cdate IS INITIAL AND s_udate IS NOT INITIAL.

      IF s_udate-high IS INITIAL.
*        CONCATENATE  'B~CHANGED_AT' ' BETWEEN ' '''' lv_date_low1+(08) '000000' '''' ' AND ' '''' lv_date_low1+(08) '235959' ''''
*                 INTO   lv_where1 RESPECTING BLANKS.
        CONCATENATE  'B~CH_DATE' ' BETWEEN ' '''' lv_date_low1+(08)  '''' ' AND ' '''' lv_date_low1+(08)  ''''
                 INTO   lv_where1 RESPECTING BLANKS.
      ELSE.
        CONCATENATE  'B~CH_DATE' ' BETWEEN ' '''' lv_date_low1+(08)  '''' ' AND ' '''' lv_date_high1+(08)  ''''
           INTO   lv_where1 RESPECTING BLANKS.
*        CONCATENATE  'B~CHANGED_AT' ' BETWEEN ' '''' lv_date_low1+(08) '000000' '''' ' AND ' '''' lv_date_high1+(08) '235959' ''''
*           INTO   lv_where1 RESPECTING BLANKS.
      ENDIF.
    ENDIF.
* End of change of DM1K964930 }
    IF p_zone IS NOT INITIAL OR p_reg IS NOT INITIAL OR p_area IS NOT INITIAL OR p_so IS NOT INITIAL OR p_so IS NOT INITIAL.
      IF ( p_mngr IS NOT INITIAL ) OR ( p_exec IS NOT INITIAL ).
        IF gt_org_x IS NOT INITIAL. "Added by logesh 28.08.2026
          SELECT h~tel_number AS tel_no,
                 b~order_no AS object_id,
                 b~proc_type,
                 b~emp_id   AS se,
                 b~customer,
                 b~psegid   AS segnm,
                 b~proc_type AS process_type,
                 b~plant AS sofc,
                 b~ord_dt AS posting_date,
                 b~origin AS origin,
                 b~ch_date AS last_upd_date,
                 b~stage,
                 b~status,
                 b~ord_qty  AS qty,              " qty
                 b~hubid AS hub,
                 b~apr_qty AS l_sale_q,
                 p~zz_exp_sdate  AS exp_sale_dt,
                 b~camp_id AS camp_id,
                 g~mdesc,                              " Model DESC
                 b~vpart AS prd,
                 m~hubds AS hub_n,
                 k~segnm AS seg_n,
                 n~appnm AS sapp_n,
                 n~sappid AS sapp,
                 n~pappid AS pappid,
                 l~appnm AS app_n,
                 b~lp_type AS ltyp,
                 q~description_20 AS ltyp_n,
                 b~lp_name AS l_id,
                 b~lp_source,
                 x~description AS lp_srcd,
                 r~type,
                 r~name_last,
                 r~name_first,
                 r~name_org1,
                 r~name_org2,
                 d~partner,
                 b~cre_date AS created_at,
                 b~p_order,
                 p~order_no AS  pros,
                 p~ord_dt AS pro_cre,
                 b~prmet,
                 b~user_id
          INTO TABLE @DATA(lt_dcr_lead_1)
          FROM zcrm_order AS b
          LEFT OUTER JOIN but020 AS d ON d~partner = b~customer
          LEFT OUTER JOIN adr2 AS h ON h~addrnumber = d~addrnumber
          LEFT OUTER JOIN zcrm_order AS p ON p~proc_type = 'ZAPR' AND p~p_order = b~order_no
          LEFT OUTER JOIN zcrmt_hub_master AS m ON m~hubid =   b~hubid
          LEFT OUTER JOIN zcrmt_psegm_mstr AS k ON k~segid =   b~psegid
          LEFT OUTER JOIN zcrmt_sappl_mstr  AS n ON n~sappid = b~appid
          LEFT OUTER JOIN zcrmt_pappl_mstr AS l ON l~appid =   n~pappid
          LEFT OUTER JOIN zcrmt_model AS g ON b~model = g~modid
          LEFT  OUTER JOIN zcrmc_source AS q ON q~source = b~lp_type
          LEFT  OUTER JOIN zcrmc_source AS x ON x~source = b~lp_source
          LEFT  OUTER JOIN but000 AS r ON r~partner = b~lp_name
          FOR ALL ENTRIES IN @gt_org_x
          WHERE b~emp_id = @gt_org_x-div_se_bp1(10)
            AND  (lv_where1)                         " Added by DM1K964930
            AND b~order_no IN @s_leadno
            AND b~stage IN @s_stage "('001','002','003')
            AND b~proc_type = 'ZALD'
            AND b~customer IN @s_kunnr
            AND b~plant = @gt_org_x-zdo+0(4)
            AND h~tel_number IN @s_mobno
            AND b~lp_type    IN @s_ltype               "#EC CI_BUFFJOIN
            AND b~camp_id  IN @s_cid
            AND b~status IN @s_stat
            AND b~business NE 'PSB'.
        ENDIF."Added by logesh 28.08.2026

      ELSE.
        IF gt_org_x IS NOT INITIAL. " Added by logesh 28.08.2026
          SELECT h~tel_number AS tel_no,
                 b~order_no AS object_id,
                 b~proc_type,
                 b~emp_id   AS se,
                 b~customer,
                 b~psegid   AS segnm,
                 b~proc_type AS process_type,
                 b~plant AS sofc,
                 b~ord_dt AS posting_date,
                 b~origin AS origin,
                 b~ch_date AS last_upd_date,
*         b~guid,
                 b~stage,
                 b~status,
                 b~ord_qty  AS qty,              " qty
                 b~hubid AS hub,
                 b~apr_qty AS l_sale_q,
                 p~zz_exp_sdate  AS exp_sale_dt,
                 b~camp_id AS camp_id,
                 g~mdesc,                              " Model DESC
                 b~vpart AS prd,
                 m~hubds AS hub_n,
                 k~segnm AS seg_n,
                 n~appnm AS sapp_n,
                 n~sappid AS sapp,
                 n~pappid AS pappid,
                 l~appnm AS app_n,
                 b~lp_type AS ltyp,
                 q~description_20 AS ltyp_n,
                 b~lp_name AS l_id,
                 b~lp_source,
                 x~description AS lp_srcd,
                 r~type,
                 r~name_last,
                 r~name_first,
                 r~name_org1,
                 r~name_org2,
                 d~partner,
                 b~cre_date AS created_at,
                 b~p_order,
                 p~order_no AS  pros,
                 p~ord_dt AS pro_cre,
                 b~prmet,
                 b~user_id
          INTO TABLE @lt_dcr_lead_1
          FROM zcrm_order AS b
          LEFT OUTER JOIN but020 AS d ON d~partner = b~customer
          LEFT OUTER JOIN adr2 AS h ON h~addrnumber = d~addrnumber
          LEFT OUTER JOIN zcrm_order AS p ON p~proc_type = 'ZAPR' AND p~p_order = b~order_no
          LEFT OUTER JOIN zcrmt_hub_master AS m ON m~hubid =   b~hubid
          LEFT OUTER JOIN zcrmt_psegm_mstr AS k ON k~segid =   b~psegid
          LEFT OUTER JOIN zcrmt_sappl_mstr  AS n ON n~sappid = b~appid
          LEFT OUTER JOIN zcrmt_pappl_mstr AS l ON l~appid =   n~pappid
          LEFT OUTER JOIN zcrmt_model AS g ON b~model = g~modid
          LEFT  OUTER JOIN zcrmc_source AS q ON q~source = b~lp_type
          LEFT  OUTER JOIN zcrmc_source AS x ON x~source = b~lp_source
          LEFT  OUTER JOIN but000 AS r ON r~partner = b~lp_name
          FOR ALL ENTRIES IN @gt_org_x
          WHERE
                   (lv_where1)                         " Added by DM1K964930
            AND b~order_no IN @s_leadno
            AND b~stage IN @s_stage "('001','002','003')
            AND b~proc_type = 'ZALD'
            AND b~customer IN @s_kunnr
            AND h~tel_number IN @s_mobno
            AND b~plant = @gt_org_x-zdo+0(4)
            AND b~lp_type  IN @s_ltype                 "#EC CI_BUFFJOIN
            AND b~camp_id  IN @s_cid " OR r~external_id IN @s_cid )
            AND b~status IN @s_stat
            AND b~business NE 'PSB'.
        ENDIF. "Added by logesh 28.08.2026
      ENDIF.
    ELSE.
      IF gt_org_x IS NOT INITIAL. "Added by logesh 28.08.2026
        SELECT h~tel_number AS tel_no,
               b~order_no AS object_id,
               b~proc_type,
               b~emp_id   AS se,
               b~customer,
               b~psegid   AS segnm,
               b~proc_type AS process_type,
               b~plant AS sofc,
               b~ord_dt AS posting_date,
               b~origin AS origin,
*         b~cre_date AS last_upd_date,
               b~ch_date AS last_upd_date,
               b~stage,
               b~status,
               b~ord_qty  AS qty,              " qty
               b~hubid AS hub,
               b~apr_qty AS l_sale_q,
               p~zz_exp_sdate  AS exp_sale_dt,
               b~camp_id AS camp_id,
               g~mdesc,                              " Model DESC
               b~vpart AS prd,
               m~hubds AS hub_n,
               k~segnm AS seg_n,
               n~appnm AS sapp_n,
               n~sappid AS sapp,
               n~pappid AS pappid,
               l~appnm AS app_n,
               b~lp_type AS ltyp,
               q~description_20 AS ltyp_n,
               b~lp_name AS l_id,
               b~lp_source,
               x~description AS lp_srcd,
               r~type,
               r~name_last,
               r~name_first,
               r~name_org1,
               r~name_org2,
               d~partner,
               b~cre_date AS created_at,
               b~p_order,
               p~order_no AS  pros,
               p~ord_dt AS pro_cre,
               b~prmet,
               b~user_id

        INTO TABLE @lt_dcr_lead_1
        FROM zcrm_order AS b
        LEFT OUTER JOIN but020 AS d ON d~partner = b~customer
        LEFT OUTER JOIN adr2 AS h ON h~addrnumber = d~addrnumber
        LEFT OUTER JOIN zcrm_order AS p ON p~proc_type = 'ZAPR' AND p~p_order = b~order_no
        LEFT OUTER JOIN zcrmt_hub_master AS m ON m~hubid =   b~hubid
        LEFT OUTER JOIN zcrmt_psegm_mstr AS k ON k~segid =   b~psegid
        LEFT OUTER JOIN zcrmt_sappl_mstr  AS n ON n~sappid = b~appid  "(legth mismatch)
        LEFT OUTER JOIN zcrmt_pappl_mstr AS l ON l~appid =   n~pappid
        LEFT OUTER JOIN zcrmt_model AS g ON b~model = g~modid
        LEFT OUTER JOIN zcrmt_dcr_001 AS o ON o~object_id_l = b~order_no           "Added by Rajkumar After PROD
        LEFT  OUTER JOIN zcrmc_source AS q ON q~source = b~lp_type
        LEFT  OUTER JOIN zcrmc_source AS x ON x~source = b~lp_source
        LEFT  OUTER JOIN but000 AS r ON r~partner = b~lp_name
        LEFT OUTER JOIN zcrmt_llos_notif AS lo1
          ON lo1~object_id = b~order_no
        FOR ALL ENTRIES IN @gt_org_x
        WHERE
              (lv_where1)
          AND b~order_no IN @s_leadno
          AND b~stage IN @s_stage
          AND b~proc_type = 'ZALD'
          AND b~customer  IN @s_kunnr
          AND h~tel_number IN @s_mobno
          AND b~plant = @gt_org_x-zdo+0(4)
          AND b~lp_type IN @s_ltype                    "#EC CI_BUFFJOIN
          AND b~camp_id IN @s_cid
          AND b~status IN @s_stat
          AND b~business NE 'PSB'.
      ENDIF."Added by logesh 28.08.2026
    ENDIF.
    DATA(lt_lead) = lt_dcr_lead_1[].
    SORT : lt_dcr_lead_1 BY object_id.
    DELETE ADJACENT DUPLICATES FROM lt_dcr_lead_1 COMPARING object_id.
    IF lt_dcr_lead_1[] IS NOT INITIAL.

      LOOP AT lt_dcr_lead_1 ASSIGNING FIELD-SYMBOL(<fs1>).
        CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
          EXPORTING
            input  = <fs1>-customer
          IMPORTING
            output = <fs1>-customer.
        MOVE-CORRESPONDING <fs1> TO gs_lead.
*        gs_lead-appln  = <fs1>-pappid.
*        gs_lead-app_n  = <fs1>-app_n.
*        gs_lead-sapp = <fs1>-sapp.
*        gs_lead-sapp_n  = <fs1>-sapp_n.
