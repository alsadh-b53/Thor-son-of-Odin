FORM top_of_page.

  DATA: lt_header TYPE slis_t_listheader,
        ls_header TYPE slis_listheader.
* Title
  ls_header-typ  = 'H'.
  ls_header-info = TEXT-002.
  APPEND ls_header TO lt_header.
  CLEAR ls_header.
  ls_header-typ  = 'S'.
  ls_header-key = TEXT-017.
  gv_cdate_l = s_cdate-low.
  gv_cdate_h = s_cdate-high.

  CONCATENATE gv_cdate_l+6(2) gv_cdate_l+4(2) gv_cdate_l+0(4) INTO gv_cdate_l SEPARATED BY '.'.
  CONCATENATE gv_cdate_h+6(2) gv_cdate_h+4(2) gv_cdate_h+0(4) INTO gv_cdate_h SEPARATED BY '.'.

  IF s_cdate-low IS NOT INITIAL AND s_cdate-high IS NOT INITIAL.
    CONCATENATE gv_cdate_l 'to' gv_cdate_h INTO ls_header-info SEPARATED BY ''.
  ELSE.
    IF s_cdate-low IS NOT INITIAL.
      ls_header-info = gv_cdate_l.
    ELSE.
      IF s_cdate-high IS NOT INITIAL.
        ls_header-info = gv_cdate_h.
      ENDIF.
    ENDIF.
  ENDIF.
  APPEND ls_header TO lt_header.
  CLEAR: ls_header.

  " no of entry
  ls_header-typ  = 'S'.
  ls_header-key = TEXT-018.
  MOVE gv_entry TO ls_header-info.
  APPEND ls_header TO lt_header.
  CLEAR: ls_header.

  CALL FUNCTION 'REUSE_ALV_COMMENTARY_WRITE'
    EXPORTING
      it_list_commentary = lt_header.
ENDFORM.
